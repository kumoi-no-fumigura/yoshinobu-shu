   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "子規",
   "author": "",
   "text": "ce時鳥寢覺に聲を聞しよりあやめも知ぬ物をこそ思へ",
   "sachu": "",
   "jo": ""
  },
  {
