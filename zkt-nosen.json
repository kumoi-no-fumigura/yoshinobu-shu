   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "夏蟲",
   "author": "",
   "text": "『燃る火の中の契を夏蟲のいかにせしかば身にもかふ覽",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0048",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓終夜片燃え渡る蚊遣火に戀する人をよそへてぞみる",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0049",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "刈萱",
   "author": "",
   "text": "三東路を別るゝ萱の亂れつゝたが爲とかは吹て靡かむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0050",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "秋霧",
   "author": "",
   "text": "秋秋の峯にもをにも立田山紅葉の錦たまらざるらし",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0051",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "女郞花",
   "author": "",
   "text": "女郎花あだにや身をば思ふらむ露の心に過たれつゝ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0052",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "薄",
   "author": "",
   "text": "我だにも結置きてか花薄なべて人をば招きしもせじ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0053",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "時雨",
   "author": "",
   "text": "柚山に立つ煙こそ神無月時雨をくだす雲となるらし",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0054",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "初霜",
   "author": "",
   "text": "〓〓夜を寒み籬の草を見渡せば今朝ぞ初霜置にけらしな",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0055",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "氷",
   "author": "",
   "text": "九山川を落來る瀧の音もせず今は氷に閉ぢぞしぬらし",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0056",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "同じやうなる事人のし侍るに、初春",
   "author": "",
   "text": "○隠沼の氷のまより下根さし蘆の二葉も今やとくらむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0057",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "霞",
   "author": "",
   "text": "霞だにたえず有せば春きぬと何を徴に人のとはまし",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0058",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "爲",
   "author": "",
   "text": "山高み雪ふるすより爲の出る初音は今日ぞなくなる",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0059",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "梅",
   "author": "",
   "text": "司をば風に添とて梅花色さへあやなあだにをらすな",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0060",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "若菜",
   "author": "",
   "text": "〓白雪のまだ古里の春日野にいざ打拂ひ若菜つみてむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0061",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "櫻",
   "author": "",
   "text": "櫻花まだきな散そ何により春をば人の惜むなるにか",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0062",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "柳",
   "author": "",
   "text": "かともすれば風のよるにぞ靑柳の糸は中々亂初めける",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0063",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "子日松",
   "author": "",
   "text": "い早晩も引人ともや春の野に生ふる子日の松は待らむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0064",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "蛙",
   "author": "",
   "text": "〓今朝きけば澤の蛙も鳴に鳬春の暮にもなりぬべら也",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0065",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "款冬",
   "author": "",
   "text": "かこぐれつゝ春の半に成にけり今や咲くらむ山吹の花",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0066",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "歸雁",
   "author": "",
   "text": "0天の原わきて鳴なる腫がねは故〓等ね歸るなるべし",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0067",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "麥青",
   "author": "",
   "text": "一花散ば起つゝも見む常よりもさやけく照せ春夜の月",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0068",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "春雨",
   "author": "",
   "text": "我が宿の垣ほの草の淺綠ふる春雨ぞいろは染めける",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0069",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "戀",
   "author": "",
   "text": "埋木の上はつれなく有ながら下には深き戀もする哉",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0070",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "態々て逢とも夢にみつる夜は最ど寢覺の恨めしき哉",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0071",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "さりともと賴む心に謀られて死なれぬ物は命也けり",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0072",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "大人れれ戀の道なる關守は忍びに問し〓とにぞ有ける",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0073",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "旅ゆく人に、雁の聲を聞きて",
   "author": "",
   "text": "草枕我のみならず雁がねも旅の空にぞなき渡るなる",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0074",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "おほいまうちぎみの柱にて水のほとりの秋の花といふ題よめと侍るに",
   "author": "",
   "text": "水の色に花の匂を今日そへて千年の秋の例とぞみる",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0075",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "藤花",
   "author": "",
   "text": "濃紫匂へる藤の花ずりはみづなき空に浪ぞたちける",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0076",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "人の屏風に小鳥をすゑこにかひて侍るかたを書きて侍る",
   "author": "",
   "text": "。樣々に山の古巣は戀らめど此とぐらには鳴聲もせず",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0077",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "人の產して侍る所にて",
   "author": "",
   "text": "。時しもあれ春の始に生出たる松は八千世の色を添けむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0078",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "小野宮のおほいまうちぎみの月輪寺の櫻の花見侍りしに",
   "author": "",
   "text": "co山櫻千代のはる〓〓〓年より色咲增れ君が見にこば",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0079",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "しはすのつごもりの夜山寺にまかり籠りて侍るつとめて僧のもとより今日は何事か侍るといひて侍りしに",
   "author": "",
   "text": "co人知ず入りきと思しかひもなく年も越くる山路也見",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-nosen-0080",
   "pid": "873676",
   "pages": [
    16
   ],
   "no": null,
   "kotobagaki": "同じ山寺にて法師の松引きにさそひ侍るにまうでたりし室の前に大いなる松の木のもとにて昔住みける人のひきける松なりこゝにゐて侍らむと申し侍りしに",
   "author": "",
   "text": "°C引物て世々もへにける松なれど綠の色のあせずも有哉",
   "sachu": "",
   "jo": ""
  }
 ]
}
